{
  "name": "loreforge-design-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Contract emulator and presentation workbench for first-class LoreForge Designs.",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "vitest run",
    "test:e2e": "playwright test --grep-invert @visual",
    "test:visual": "npm run verify:obsidian-source && playwright test --grep @visual",
    "test:watch": "vitest",
    "capture:obsidian-source": "node scripts/capture-obsidian-source.mjs",
    "new-design": "node scripts/new-design.mjs",
    "verify:obsidian-source": "node scripts/verify-obsidian-source-snapshot.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@syncfusion/ej2-react-diagrams": "^34.2.7",
    "lucide-react": "^1.42.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.4",
    "react-arborist": "^3.16.0",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "jsdom": "^26.1.0",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^3.2.4"
  }
}
